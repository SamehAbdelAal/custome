<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Partner Search View - Add filter for partners with ledger entries -->
    <record id="view_res_partner_filter_ledger" model="ir.ui.view">
        <field name="name">res.partner.search.inherit.ledger</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="before">
                <filter string="Has Ledger Entries" name="has_ledger"
                        domain="[('has_ledger_entries', '=', True)]"/>
                <separator/>
            </xpath>
        </field>
    </record>

    <!-- Action to view only partners with ledger entries -->
    <record id="action_partners_with_ledger" model="ir.actions.act_window">
        <field name="name">Partners with Ledger</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('has_ledger_entries', '=', True)]</field>
        <field name="context">{'search_default_has_ledger': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No partners with ledger entries found
            </p>
        </field>
    </record>

    <!-- Menu for Partners with Ledger -->
    <menuitem id="menu_partners_with_ledger"
              name="Partners with Ledger"
              parent="base_accounting_kit.account_reports_partner"
              action="action_partners_with_ledger"
              sequence="5"/>

    <!-- Customer and vendor statements -->
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.view.form.inherit.base.account.report
        </field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Add Partner Ledger button to the button box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="action" class="oe_stat_button" icon="fa-book"
                        name="%(base_accounting_kit.action_partner_ledger_from_partner)d"
                        context="{'active_ids': [id], 'active_model': 'res.partner'}"
                        groups="account.group_account_invoice,account.group_account_readonly">
                    <span class="o_stat_text">Partner Ledger</span>
                </button>
            </xpath>
            <xpath expr="//page[@name='sales_purchases']" position="after">
                <page name="customer_statement_page"
                      string="Customer Statement">
                    <button name="action_print_pdf" type="object"
                            class="btn-secondary">
                        Print PDF
                    </button>
                    <button name="action_print_xlsx" type="object"
                            class="btn-secondary">
                        Print Excel
                    </button>
                    <button name="action_share_pdf" type="object"
                            class="btn-secondary">
                        Sent PDF By Email
                    </button>
                    <button name="action_share_xlsx" type="object"
                            class="btn-secondary">
                        Sent Excel By Email
                    </button>
                    <br/>
                    <br/>
                    <field name="customer_report_ids">
                        <list create='false' delete="false">
                            <field name="currency_id" column_invisible="1"/>
                            <field name="invoice_date"
                                   string="Invoice Date"/>
                            <field name="name" string="Invoice No."/>
                            <field name="invoice_date_due"/>
                            <field name="amount_total_signed"
                                   sum="Total Amount" string="Total Amount"
                                   widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="amount_residual_signed"
                                   string="Amount Due" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="amount_residual" sum="Balance Due"
                                   string="Balance" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                        </list>
                    </field>
                </page>
