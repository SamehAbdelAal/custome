<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Product Label ID: YYYY-001 -->
        <record id="seq_product_label" model="ir.sequence">
            <field name="name">Product Label Sequence</field>
            <field name="code">product.label.sequence</field>
            <field name="prefix">%(year)s-</field>
            <field name="padding">3</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="use_date_range">True</field>
        </record>
    </data>
</odoo>
