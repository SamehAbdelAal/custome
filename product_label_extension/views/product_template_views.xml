<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Template Form View Inheritance -->
    <record id="product_template_form_view_label_extension" model="ir.ui.view">
        <field name="name">product.template.form.label.extension</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//page" position="before">
                <page invisible="finsh_product" string="Label Specifications" name="label_specifications">
                    <group>
                        <group string="Product Identification">
                            <field name="label_product_id" />
                            <field name="label_customer_id" />
                        </group>
                        <group string="colors">
                            <field name="basic_colors" />
                            <field name="special_colors" />
                        </group>
                    </group>

                    <group>
                        <group string="Size Specifications">
                            <field name="size_width_mm" />
                            <field name="size_height_mm" />
                        </group>
                        <group string="Finishing Options">
                            <field name="foil_type" />
                            <field name="foil_type_other" invisible="foil_type != 'other'" />
                            <field name="lamination" />
                            <field name="thickness" invisible="open_microns" />
                            <field name="varnish" />
                        </group>
                    </group>
                    <group>
                        <group string="Roll Specifications">
                            <field name="quantity_in_roll"
                                   required="not finsh_product" />
                            <field name="core_size" />
                            <field name="winding_direction"
                                   required="not finsh_product" />
                        </group>
                        <group string="Layout Specifications">
                            <field name="gap_across_mm" />
                            <field name="gap_around_mm" />
                            <field name="image_across" required="not finsh_product" />
                            <field name="image_around" required="not finsh_product" />
                        </group>
                    </group>
                    <group>
                        <group string="Manufacturing Specs">
                            <field name="no_of_abs" />
                            <field name="cylinder_no" />
                        </group>
                        <group string="Special Features">
                            <field name="perforation" />
                            <field name="invisible_ink" />
                            <field name="back_side_print" />
                        </group>
                    </group>
                    <group>
                        <group string="Material &amp; Colors">
                            <field name="material_id" required="finsh_product == False" domain="[('finsh_product' ,'=', True)]" />
                            <field name="calculated_width" />
                            <field name="length_quantity_in_meter" />
                            <field name="attribute_id" readonly="1" invisible="viewable" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="add_field_finsh" model="ir.ui.view">
        <field name="name">fish product</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sale_ok']/.." position="before">
                <group>
                    <field name="finsh_product" string="Raw Material" />
                </group>
            </xpath>
        </field>
    </record>
    <!-- Product Template Tree View - Add key fields -->
    <record id="product_template_tree_view_label_extension" model="ir.ui.view">
        <field name="name">product.template.tree.label.extension</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="label_product_id" optional="show" />
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="label_customer_id" optional="hide" />
                <field name="material_id" optional="hide" />
            </xpath>
        </field>
    </record>

    <!-- Search View - Add filters -->
    <record id="product_template_search_view_label_extension" model="ir.ui.view">
        <field name="name">product.template.search.label.extension</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view" />
        <field name="arch" type="xml">
            <xpath expr="//filter[1]" position="before">
                <field name="label_product_id" />
                <field name="label_customer_id" />
                <separator />
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Customer" name="group_by_customer" context="{'group_by': 'label_customer_id'}" />
                <filter string="Material" name="group_by_material" context="{'group_by': 'material_id'}" />
                <filter string="Lamination" name="group_by_lamination" context="{'group_by': 'lamination'}" />
            </xpath>
        </field>
    </record>


    <record id="mrp_bom_inherit" model="ir.ui.view">
        <field name="name">mrp bom inherit</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="labels_length" readonly="1" placeholder="labels length" />
                <field name="color_length" readonly="1" placeholder="color length" />
            </xpath>
        </field>
    </record>
</odoo>
