<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_label_extension" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.label.extension</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids_without_package']//list//field[@name='product_uom_qty']" position="before">
                <field name="width_cm" optional="hide"/>
                <field name="length_m" optional="hide"/>
                <field name="number_qty" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
