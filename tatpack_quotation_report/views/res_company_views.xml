<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add TatPack footer fields to Company Settings -->
    <record id="res_company_form_tatpack_footer" model="ir.ui.view">
        <field name="name">res.company.form.tatpack.footer</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']" position="after">
                <page string="TatPack Footer" name="tatpack_footer">
                    <group>
                        <group string="Addresses">
                            <field name="head_office_address"/>
                            <field name="factory_address"/>
                        </group>
                        <group string="Contact Numbers">
                            <field name="footer_phone_1"/>
                            <field name="footer_phone_2"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
