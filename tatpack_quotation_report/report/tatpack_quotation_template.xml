<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="tatpack_external_layout">
        <t t-if="not o" t-set="o" t-value="doc" />
        <t t-if="not company">
            <t t-if="company_id">
                <t t-set="company" t-value="company_id" />
            </t>
            <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                <t t-set="company" t-value="o.company_id.sudo()" />
            </t>
            <t t-else="">
                <t t-set="company" t-value="request.env.company" />
            </t>
        </t>

        <div t-attf-class="header o_company_#{company.id}_layout" style="padding: 15px 0;">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <img t-if="company.logo" class="o_company_logo_small" t-att-src="image_data_uri(company.logo)" alt="Logo" style="max-height: 120px; max-width: 350px;" />
            </div>
        </div>

        <div t-attf-class="article o_report_layout_standard o_company_#{company.id}_layout" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id">
            <t t-out="0" />
        </div>

        <div t-attf-class="footer o_company_#{company.id}_layout" style="padding: 0; margin: 0; position: relative; min-height: 180px;">
            <div style="position: absolute; bottom: 0; left: 0; width: 100%; z-index: -1; overflow: hidden; line-height: 0;">
                <svg viewBox="0 0 400 120" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" style="width: 100%; height: 120px;">
                    <path d="M0,120 L0,40 Q100,10 200,50 Q300,90 400,40 L400,120 Z" fill="#3C2D68" opacity="0.4" />
                    <path d="M0,120 L0,60 Q120,30 240,70 Q340,100 400,70 L400,120 Z" fill="#3C2D68" opacity="0.2" />
                </svg>
            </div>

            <div style="padding: 0px 20px 10px 0px; font-family: Arial, sans-serif; position: relative; z-index: 1;">
                <div class="row">
                    <div class="col-6 offset-6">
                        <table style="width: 100%; border: 1px solid #3C2D68; border-collapse: collapse; background-color: rgba(255, 255, 255, 0.7); font-size: 13px;">
                            <tbody>
                                <tr>
                                    <td style="width: 30px; vertical-align: top; padding: 8px 0px 0px 8px; border-bottom: 1px solid #3C2D68;">
                                        <i class="fa fa-map-marker" style="color: #e74c3c; font-size: 16px;" />
                                    </td>
                                    <td style="padding: 8px 8px 5px 0px; border-bottom: 1px solid #3C2D68;">
                                        <span style="color: #e74c3c; font-weight: bold;">Headoffice:</span>
                                        <span style="color: #3C2D68; font-weight: bold;" t-esc="company.head_office_address or '87, Pharaonic Company Blocks, Block No. 3, El Mariouteya Faisal.'" />
                                        <br />
                                        <span style="color: #e74c3c; font-weight: bold;">Factory :</span>
                                        <span style="color: #3C2D68; font-weight: bold;" t-esc="company.factory_address or 'Abu Rawash - El Mansourieh Haram Road, next to Star Water.'" />
                                    </td>
                                </tr>
                                <tr>
                                    <td style="vertical-align: middle; padding: 5px 0px 5px 8px; border-bottom: 1px solid #3C2D68;">
                                        <i class="fa fa-globe" style="color: #3C2D68; font-size: 14px;" />
                                    </td>
                                    <td style="color: #3C2D68; font-weight: bold; padding: 5px 8px 5px 0px; border-bottom: 1px solid #3C2D68;" t-esc="company.website or 'http://www.example.com'" />
                                </tr>
                                <tr>
                                    <td style="vertical-align: top; padding: 5px 0px 8px 8px;">
                                        <i class="fa fa-phone" style="color: #3C2D68; font-size: 14px;" />
                                    </td>
                                    <td style="color: #3C2D68; font-weight: bold; padding: 5px 8px 8px 0px;">
                                        <div style="margin-bottom: 2px;">•
                                            <t t-esc="company.footer_phone_1 or '00235951307'" />
                                        </div>
                                        <div>•
                                            <t t-esc="company.footer_phone_2 or '01014077379'" />
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="text-center text-white mt-2" style="color: black; font-weight: bold; font-size: 12px;">
                            (Page
                            <span class="page" />
                            of
                            <span class="topage" />)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <template id="report_tatpack_quotation_document">
        <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)" />
        <t t-set="company" t-value="doc.company_id" />
        <t t-call="tatpack_quotation_report.tatpack_external_layout">
            <style>
                .color1 { color: #1a237e; }
                .tatpack-page {
                font-family: Arial, sans-serif;
                font-size: 15px !important;
                color: #1a237e;
                }
                .product-table {
                width: 100%;
                margin-bottom: 20px;
                border: 1px solid #1a237e;
                border-collapse: collapse;
                }
                .product-table td {
                border: 1px solid #1a237e;
                padding: 5px 8px;
                vertical-align: middle;
                }
                .label-col {
                width: 180px;
                font-weight: bold;
                }
                .value-text {
                font-weight: 900;
                }
                .red-value {
                color: #d32f2f;
                font-weight: 900;
                }
            </style>

            <div class="page pt-2 tatpack-page">
                <div style="margin-bottom: 10px;">
                    <strong class="fw-bolder fs-5">
                        <t t-esc="doc.partner_id.name" />
                        <t t-if="doc.partner_id.parent_id">
                            (<t t-esc="doc.partner_id.parent_id.name" />)
                        </t>
                    </strong>
                </div>

                <div style="margin-bottom: 15px;">
                    <span class="fw-bold">Date:</span>
                    <span t-field="doc.date_order" t-options='{"widget": "date", "format": "dd-MM-yyyy"}' />
                </div>

                <div style="text-align: center; margin: 15px 0;">
                    <strong class="fw-bolder" style="font-size: 18px;">Quotation No.
                        <t t-esc="doc.name" />
                    </strong>
                </div>

                <div style="margin-bottom: 15px;">
                    <span class="fw-bold fs-5" style="text-decoration: underline;">
                        Re.:
                        <t t-esc="doc.quotation_subject or 'quotation subject'" />
                    </span>
                </div>

                <div style="margin-bottom: 15px;">
                    <p class="fw-bold" style="margin-bottom: 5px;">Dear,</p>
                    <p>We thank you for your recent enquiry for which we have pleasure in submitting the following quotation.</p>
                </div>

                <t t-foreach="doc.order_line" t-as="line">
                    <t t-if="not line.display_type">
                        <t t-set="product" t-value="line.product_id.product_tmpl_id" />

                        <table class="product-table">
                            <tr>
                                <td class="label-col">Product Description</td>
                                <td>
                                    <span class="value-text">:
                                        <t t-esc="line.name" />
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <td class="label-col">Size</td>
                                <td>
                                    <span class="value-text">:
                                        <t t-esc="product.size_width_mm or '0'" />
                                        mm X
                                        <t t-esc="product.size_height_mm or '0'" />
                                        mm
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <td class="label-col">No. of Colors</td>
                                <td>
                                    <span class="value-text">: [F]
                                        <t t-esc="product.basic_colors or '0'" />
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <td class="label-col">Material</td>
                                <td>
                                    <span class="value-text">:
                                        <t t-esc="product.material_id.name if product.material_id else 'PE White'" />
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <td class="label-col">No. of variants</td>
                                <td>
                                    <span class="value-text">:
                                        <t t-esc="line.no_of_variants or 1" />
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <td class="label-col">Quantity</td>
                                <td>
                                    <span class="value-text">:</span>
                                    <span class="red-value">
                                        <t t-esc="'{:,.0f}'.format(line.product_uom_qty)" />
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <td class="label-col">Price 1000/Label</td>
                                <td>
                                    <span class="value-text">:</span>
                                    <span class="red-value">
                                        <t t-esc="doc.currency_id.symbol" />
                                        <t t-esc="'%.3f' % line.price_unit" />
                                    </span>
                                </td>
                            </tr>
                        </table>
                    </t>
                </t>

                <div t-if="doc.note" style="margin-top: 20px;">
                    <p t-field="doc.note" />
                </div>

            </div>
        </t>
    </template>

    <template id="report_tatpack_quotation">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="tatpack_quotation_report.report_tatpack_quotation_document" t-lang="doc.partner_id.lang" />
            </t>
        </t>
    </template>

</odoo>