<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Custom Paper Format for TatPack Quotation -->
    <record id="paperformat_tatpack_quotation" model="report.paperformat">
        <field name="name">Tatpack A4</field>
        <field name="default" eval="False" />
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">40</field>
        <field name="margin_bottom">25</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">35</field>
        <field name="dpi">90</field>
        <field name="disable_shrinking" eval="False" />
    </record>

    <!-- Main Report Template with Standard Header/Footer -->
    <template id="sale_design_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="company" t-value="doc.company_id" />
                <t t-call="web.external_layout_standard">
                    <style>
                        .color1 { color: #1a237e; }
                        .tatpack-page {
                            font-family: Arial, sans-serif;
                            font-size: 14px;
                            color: #333;
                        }
                        .tatpack-page p { margin: 2px 0; }
                        .highlight-box {
                            background: rgba(0,0,0,0.1);
                            padding: 5px 15px;
                            display: inline-block;
                        }
                        .product-table td {
                            padding: 3px 0;
                            vertical-align: top;
                        }
                        .product-table td:first-child {
                            width: 180px;
                            font-weight: bold;
                        }
                    </style>

                    <div class="page tatpack-page">
                        <!-- Customer Name -->
                        <div style="margin-bottom: 10px;">
                            <strong class="color1" style="font-size: 18px;">
                                <t t-esc="doc.partner_id.name" />
                                <t t-if="doc.partner_id.parent_id">
                                    (<t t-esc="doc.partner_id.parent_id.name" />)
                                </t>
                            </strong>
                        </div>

                        <!-- Date -->
                        <div style="margin-bottom: 3px;">
                            <span class="color1" style="font-weight: bold;">Date:</span>
                            <span class="color1" t-field="doc.date_order" t-options='{"widget": "date", "format": "dd-MM-yyyy"}' />
                        </div>

                        <!-- Quotation Number -->
                        <div style="text-align: center; margin: 15px 0;">
                            <strong class="color1" style="font-size: 18px;">
                                Quotation No. <t t-esc="doc.name" />
                            </strong>
                        </div>

                        <!-- Subject Line -->
                        <div style="margin-bottom: 10px;">
                            <span class="color1" style="font-weight: bold; text-decoration: underline; font-size: 16px;">
                                Re.: <t t-esc="doc.quotation_subject or 'labels enquiry'" />
                            </span>
                        </div>

                        <!-- Opening Text -->
                        <div style="margin-bottom: 15px;">
                            <p class="color1" style="font-size: 16px;">Dear,</p>
                            <p class="color1">We thank you for your recent enquiry for which we have pleasure in submitting the following quotation.</p>
                        </div>

                        <!-- Product Details Section -->
                        <t t-foreach="doc.order_line" t-as="line">
                            <t t-if="not line.display_type">
                                <t t-set="product" t-value="line.product_id.product_tmpl_id" />

                                <table class="product-table" style="width: 100%; margin-bottom: 15px;">
                                    <tr>
                                        <td class="color1">Product Description</td>
                                        <td class="color1" style="font-weight: bold;">
                                            : <t t-esc="line.name" />
                                        </td>
                                    </tr>
                                    <tr t-if="product.size_width_mm or product.size_height_mm">
                                        <td class="color1">Size</td>
                                        <td class="color1" style="font-weight: bold;">
                                            : <t t-esc="product.size_width_mm or '0'" /> mm X <t t-esc="product.size_height_mm or '0'" /> mm
                                        </td>
                                    </tr>
                                    <tr t-if="product.basic_colors">
                                        <td class="color1">No. of Colors</td>
                                        <td class="color1" style="font-weight: bold;">
                                            : [F] <t t-esc="product.basic_colors or '0'" />
                                            <t t-if="product.lamination and product.lamination != 'no'"> + Lamination</t>
                                            <t t-if="product.back_side_print">
                                                - [B] <t t-esc="product.special_colors or '0'" />
                                                <t t-if="product.lamination and product.lamination != 'no'"> + Lamination</t>
                                            </t>
                                        </td>
                                    </tr>
                                    <tr t-if="product.material_id">
                                        <td class="color1">Material</td>
                                        <td class="color1" style="font-weight: bold;">
                                            : <t t-esc="product.material_id.name if product.material_id else 'PE White'" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="color1">No. of Variants</td>
                                        <td class="color1" style="font-weight: bold;">
                                            : <t t-esc="line.no_of_variants or 1" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="color1">Quantity</td>
                                        <td>
                                            <span class="color1">:</span>
                                            <span style="color: #d32f2f; font-weight: bold;">
                                                <t t-esc="'{:,.0f}'.format(line.product_uom_qty)" />
                                            </span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="color1">Price 1000/Label</td>
                                        <td>
                                            <span class="color1">:</span>
                                            <span style="color: #d32f2f; font-weight: bold;">
                                                <t t-esc="doc.currency_id.symbol" />
                                                <t t-esc="'%.3f' % line.price_unit" />
                                            </span>
                                        </td>
                                    </tr>
                                </table>
                            </t>
                        </t>

                        <!-- Tax Note -->
                        <div style="margin: 12px 0;">
                            <span class="color1 highlight-box" style="font-weight: bold;">
                                <t t-if="not doc.prices_include_tax">** The prices not Included sales tax</t>
                                <t t-else="">** The prices Include sales tax</t>
                            </span>
                        </div>

                        <!-- Terms and Conditions -->
                        <div style="margin: 15px 0;">
                            <p class="color1" style="font-weight: bold; text-decoration: underline; margin-bottom: 10px; font-size: 16px;">
                                Terms and conditions of sale:
                            </p>

                            <table style="width: 100%;">
                                <tr>
                                    <td class="color1" style="width: 180px; padding: 3px 0;">Delivery Terms</td>
                                    <td class="color1" style="padding: 3px 0;">
                                        : <t t-esc="doc.delivery_terms or 'To be discussed.'" />
                                    </td>
                                </tr>
                                <tr>
                                    <td class="color1" style="padding: 3px 0;">Lead Time</td>
                                    <td class="color1" style="padding: 3px 0;">
                                        : <t t-esc="doc.lead_time or 'To be discussed.'" />
                                    </td>
                                </tr>
                                <tr>
                                    <td class="color1" style="padding: 3px 0;">Validity of Quotation</td>
                                    <td class="color1" style="padding: 3px 0;">
                                        : <t t-esc="doc.validity_days or '5 Days.'" />
                                    </td>
                                </tr>
                                <tr>
                                    <td class="color1" style="padding: 3px 0;">Payment Terms</td>
                                    <td class="color1" style="padding: 3px 0;">
                                        : <t t-esc="doc.payment_terms_text or '45 days from the date of receipt'" />
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- Tolerance Note -->
                        <div style="margin: 15px 0;">
                            <span class="color1 highlight-box" style="font-weight: bold;">
                                Customer must accept <t t-esc="doc.tolerance_percentage or '+/- 10%'" /> of the Order quantity
                            </span>
                        </div>

                        <!-- Closing Text -->
                        <div style="margin: 20px 0;">
                            <p class="color1" style="font-size: 16px; font-weight: bold;">
                                <t t-esc="doc.closing_text or 'We hope the above offer meets with your expectations and look forward to receiving your further instructions.'" />
                            </p>
                        </div>

                        <!-- Signature Section -->
                        <div style="margin: 20px 0; color: #1a237e;">
                            <p>Yours faithfully,</p>
                            <p style="margin-top: 15px;">
                                For <t t-esc="doc.signatory_company or 'TaTPack'" />
                            </p>
                            <p style="margin-top: 15px;">
                                <strong><t t-esc="doc.signatory_name or 'Mahmoud Abdullah'" /></strong>
                            </p>
                            <p style="margin-top: 10px;">
                                <strong>Mobil No:</strong>
                            </p>
                            <p><t t-esc="doc.signatory_mobile or '01000575130'" /></p>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- TatPack Quotation Report Action -->
    <record id="action_report_sale_quotation" model="ir.actions.report">
        <field name="name">Quotation Design</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tatpack_quotation_report.sale_design_report</field>
        <field name="report_file">tatpack_quotation_report.sale_design_report</field>
        <field name="print_report_name">'Quotation - %s' % (object.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_order" />
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_tatpack_quotation" />
    </record>

</odoo>
